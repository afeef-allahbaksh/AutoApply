{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoApply Companies Registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "ats", "slug", "careers_url", "added"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "ats": {
        "type": "string",
        "enum": ["greenhouse", "lever", "ashby", "workday"]
      },
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "careers_url": {
        "type": "string",
        "minLength": 1
      },
      "added": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "shard": {
        "type": "string",
        "pattern": "^wd\\d+$",
        "description": "Workday only — the data-center shard (wd1, wd3, wd5, etc.)."
      },
      "site": {
        "type": "string",
        "minLength": 1,
        "description": "Workday only — the named career site (e.g. NVIDIAExternalCareerSite)."
      },
      "locale": {
        "type": "string",
        "pattern": "^[a-z]{2}-[A-Z]{2}$",
        "description": "Workday only — locale segment of the careers URL (e.g. en-US)."
      }
    },
    "additionalProperties": false
  }
}
