{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoApply Inbox Proposals",
  "description": "Pending review-queue items produced by the email sync.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "action_type", "proposed_status", "confidence", "resolution"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "thread_id": { "type": "string" },
      "message_subject": { "type": "string" },
      "message_from": { "type": "string" },
      "message_received_at": { "type": "string" },
      "message_url": { "type": "string" },
      "action_type": {
        "type": "string",
        "enum": ["new_application", "status_update"]
      },
      "company": { "type": "string" },
      "role": { "type": "string" },
      "proposed_status": {
        "type": "string",
        "enum": ["applied", "screen", "technical", "onsite", "offer", "rejected"]
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "reasoning": { "type": "string" },
      "resolution": {
        "type": "string",
        "enum": ["match", "ambiguous", "no_match"]
      },
      "target_idx": { "type": ["integer", "null"], "minimum": 0 },
      "candidates": {
        "type": "array",
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "additionalProperties": false
  }
}
